# Store Helep — environment template (copy to .env and fill in secrets)
# AI/OCR provider. AQ.-prefixed keys are Google Gemini Auth keys — use
# OCR_PROVIDER=gemini with the native endpoint below. Set OCR_ENABLED=true to
# use the real model; otherwise the app uses a mock extractor offline.
OCR_ENABLED=false
OCR_PROVIDER=gemini
OCR_API_KEY=
OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
OCR_MODEL=gemini-2.0-flash
