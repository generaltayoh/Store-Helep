# Store Helep — environment template (copy to .env and fill in secrets)

# Server Configuration
PORT=3000
CURRENCY_CODE=FCFA
LOW_STOCK_THRESHOLD=5
PROFIT_MARGIN=0.33

# PostgreSQL (Neon) Database Configuration
# Copy the connection string from Neon Console -> Connection Details.
# Use the pooled connection string (contains "-pooler").
DATABASE_URL=postgres://user:password@ep-xxx-region.aws.neon.tech/neondb?sslmode=require
# Neon requires SSL; set to "false" only for local Postgres without SSL.
DB_SSL=true

# AI/OCR provider. AQ.-prefixed keys are Google Gemini Auth keys — use
# OCR_PROVIDER=gemini with the native endpoint below. Set OCR_ENABLED=true to
# use the real model; otherwise the app uses a mock extractor offline.
OCR_ENABLED=false
OCR_PROVIDER=gemini
OCR_API_KEY=
OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
OCR_MODEL=gemini-2.0-flash

